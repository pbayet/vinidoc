{
  "name": "vinidoc",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "author": "Paul Bayet",
  "scripts": {
    "archive": "node ../scripts/archive-version.mjs",
    "release": "node ../scripts/bump-version.mjs",
    "new-project": "node ../scripts/new-project.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "lint": "eslint .",
    "preview": "vite preview",
    "reload:node-modules": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item 'node_modules' -Recurse -ErrorAction SilentlyContinue\" && powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item 'package-lock.json' -ErrorAction SilentlyContinue\" && npm install && npm run dev",
    "deploy": "node ../scripts/deploy.mjs prod",
    "deploy:test": "node ../scripts/deploy.mjs test",
    "deploy:all": "npm run deploy && npm run deploy:test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@uvcdr/api-auth-system": "https://dev.union-vignerons.com/npm/uvcdr/api-auth-system/0.3.0",
    "@uvcdr/app-shell": "https://dev.union-vignerons.com/npm/uvcdr/app-shell/0.1.3",
    "@uvcdr/attachments": "https://dev.union-vignerons.com/npm/uvcdr/attachments/0.2.0",
    "@uvcdr/confirm-notify-system": "https://dev.union-vignerons.com/npm/uvcdr/confirm-notify-system/0.2.0",
    "@uvcdr/contracts": "https://dev.union-vignerons.com/npm/uvcdr/contracts/0.1.1",
    "@uvcdr/custom-form-system": "https://dev.union-vignerons.com/npm/uvcdr/custom-form-system/3.4.0",
    "@uvcdr/custom-list": "https://dev.union-vignerons.com/npm/uvcdr/custom-list/1.1.2",
    "@uvcdr/data-query": "https://dev.union-vignerons.com/npm/uvcdr/data-query/0.1.0",
    "@uvcdr/modal": "https://dev.union-vignerons.com/npm/uvcdr/modal/0.2.1",
    "@uvcdr/realtime": "https://dev.union-vignerons.com/npm/uvcdr/realtime/0.1.0",
    "@uvcdr/statistics-system": "https://dev.union-vignerons.com/npm/uvcdr/statistics-system/1.1.0",
    "@uvcdr/unis-theme": "https://dev.union-vignerons.com/npm/uvcdr/unis-theme/0.2.0",
    "@uvcdr/utils": "https://dev.union-vignerons.com/npm/uvcdr/utils/0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "@uvcdr/api-auth-system": false,
    "@uvcdr/app-shell": false,
    "@uvcdr/attachments": false,
    "@uvcdr/confirm-notify-system": false,
    "@uvcdr/contracts": false,
    "@uvcdr/custom-form-system": false,
    "@uvcdr/custom-list": false,
    "@uvcdr/data-query": false,
    "@uvcdr/modal": false,
    "@uvcdr/realtime": false,
    "@uvcdr/statistics-system": false,
    "@uvcdr/unis-theme": false,
    "@uvcdr/utils": false,
    "@swc/core": false,
    "@parcel/watcher": false
  }
}
