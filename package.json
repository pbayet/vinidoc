{
  "name": "vinidoc",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "lint": "eslint .",
    "preview": "vite preview",
    "reload:node-modules": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item 'node_modules' -Recurse -ErrorAction SilentlyContinue\" && powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item 'package-lock.json' -ErrorAction SilentlyContinue\" && npm install && npm run dev"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@uvcdr/api-auth-system": "https://dev.union-vignerons.com/npm/uvcdr/api-auth-system/0.1.0",
    "@uvcdr/confirm-notify-system": "https://dev.union-vignerons.com/npm/uvcdr/confirm-notify-system/0.1.0",
    "@uvcdr/custom-form-system": "https://dev.union-vignerons.com/npm/uvcdr/custom-form-system/3.1.1",
    "@uvcdr/modal": "https://dev.union-vignerons.com/npm/uvcdr/modal/0.1.0",
    "deep-diff": "^1.0.2",
    "lodash": "^4.17.21",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "@uvcdr/api-auth-system": false,
    "@uvcdr/confirm-notify-system": false,
    "@uvcdr/custom-form-system": false,
    "@uvcdr/modal": false,
    "@swc/core": false,
    "@parcel/watcher": false
  }
}
